# Required
GEMINI_API_KEY=
# Users of the web UI / API must enter this key. Leave empty only on a private network.
API_KEY=change-me

# Models
EMBED_MODEL=gemini-embedding-001
# 128-3072. Changing it needs a new Milvus collection (set a new COLLECTION_PREFIX).
EMBED_DIM=1536
GEMINI_MODEL=gemini-3.5-flash-lite

# OCR for scanned pages and images: docling (open source: layout + tables + OCR), tesseract, or gemini (paid)
OCR_ENGINE=docling
# OCR engine inside Docling (tesseract read our scans best) and its languages (add ,hi for Hindi)
DOCLING_OCR=tesseract
DOCLING_LANG=en
OCR_LANG=eng+hin

# Scaling
WORKERS=2
OCR_WORKERS=4
MAX_UPLOAD_MB=200

# Ports on this machine
FRONTEND_PORT=4200
API_PORT=8000
# Also log successful GET calls in the API log (off: the UI polls /documents every few seconds)
LOG_GET_REQUESTS=false

# Guardrails: questions per client per minute (0 = no limit); documents with fewer readable words are rejected;
# ask the model once more when an answer has numbers its sources do not contain
ASK_RATE_PER_MINUTE=30
MIN_DOCUMENT_WORDS=5
GUARD_RETRY=true

# Worker threads started inside the backend (`fastapi dev` processes uploads by itself)
EMBEDDED_WORKERS=2

# Gemini quota. Big files need many embedding requests; if the key's per-minute quota is hit (429),
# processing pauses until the quota window passes and then continues (up to QUOTA_WAIT_MINUTES).
# Set EMBED_TOKENS_PER_MINUTE a bit below your key's limit to avoid the pauses (0 = no pacing).
EMBED_TOKENS_PER_MINUTE=0
QUOTA_WAIT_MINUTES=20

# Databases (the compose file runs them on this machine)
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
POSTGRES_PASSWORD=rag
MILVUS_URI=http://localhost:19530
COLLECTION_PREFIX=rag
# Changing EMBED_DIM needs a new collection: set a new COLLECTION_PREFIX.
